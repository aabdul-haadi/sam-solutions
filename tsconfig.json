{
  "compilerOptions": {
    "target": "esnext", 
    "module": "esnext",
    "moduleResolution": "node",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,  // Skip type checking of declaration files for faster compilation
    "jsx": "react",  // React JSX support
    "composite": true,  // Enable project references (required for multi-project setups)
    "resolveJsonModule": true,  // Enable importing JSON files as modules
    "outDir": "./dist",  // Where the compiled code should go
    "baseUrl": "./",  // Base directory for non-relative module imports
    "paths": {
      "@components/*": ["src/components/*"],  // Example path alias for components
      "@utils/*": ["src/utils/*"]  // Example path alias for utilities
    }
  },
  "include": [
    "src/**/*"  // Include all source files
  ],
  "references": [
   { "path": "./tsconfig.app.json" },
    { "path": "./tsconfig.node.json" }
  ]
}




